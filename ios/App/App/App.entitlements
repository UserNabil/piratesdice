<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ⚠️ SANS CETTE CAPACITE, « Sign in with Apple » NE S'OUVRE PAS. Le profil
	     de provisionnement doit la porter, et Apple ne l'ajoute au profil que si
	     l'application la declare ici. Elle est aussi ce qui rend l'application
	     conforme a la directive 4.8 le jour ou une connexion tierce apparait. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
