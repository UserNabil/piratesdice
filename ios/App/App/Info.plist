<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>The Pirate's Dice</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- ⛔ SUR TELEPHONE, LE JEU NE SE JOUE QU'EN PAYSAGE. Deux plateaux de
	     quatre colonnes cote a cote demandent de la LARGEUR : en portrait, les
	     cases retrecissent jusqu'a rendre les des illisibles, la carte du
	     capitaine se coupe et la barre du bas mange le reste. On perdait du
	     contenu sans le dire. L'iPad, lui, garde toutes ses orientations : il a
	     la place dans les deux sens. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.nabil.piratesdice</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>piratesdice</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>google-signin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.975326394375-2tt38bv4rum7vdtj2m9o9qanhggpcu3h</string>
			</array>
		</dict>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- ⛔ SANS CECI, APPLE REFUSE LE PORTRAIT SEUL SUR IPAD (erreur 90474). Un jeu
	     qui NE se resize pas (pas de Split View ni Stage Manager) a le droit de se
	     verrouiller en portrait ; mais tant qu'il « supporte le multitache », Apple
	     exige les QUATRE orientations sur iPad. On declare donc l'app plein ecran :
	     c'est ce qu'elle est, et c'est ce qui autorise le verrou portrait. -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
</dict>
</plist>
